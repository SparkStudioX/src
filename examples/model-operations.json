    "udtDefinitions": [
      {
        "id": "WorkshopPress",
        "version": 1,
        "description": "Original synthetic press model for learning field contracts and reusable mappings.",
        "semanticId": "urn:sparkstudio:workshop:press",
        "parameters": [
          {
            "name": "Device",
            "type": "String",
            "required": true
          }
        ],
        "members": [
          {
            "path": "Load",
            "kind": "memory",
            "dataType": "Int32",
            "value": 0,
            "unit": "%",
            "unitSystem": "ucum",
            "range": {
              "low": 0,
              "high": 100
            },
            "freshnessMs": 0,
            "semanticId": "urn:sparkstudio:workshop:press:load",
            "description": "Synthetic motor load",
            "alarms": [
              {
                "id": "HighLoad",
                "name": "High press load",
                "enabled": true,
                "mode": "high",
                "setpoint": 80,
                "deadband": 2,
                "priority": 2,
                "message": "Synthetic training alarm: inspect press load."
              }
            ]
          },
          {
            "path": "State",
            "kind": "memory",
            "dataType": "String",
            "value": "idle",
            "enumValues": [
              "idle",
              "running",
              "fault"
            ],
            "description": "Declared example machine states"
          },
          {
            "path": "CycleCount",
            "kind": "memory",
            "dataType": "Int64",
            "value": 0,
            "unit": "1",
            "unitSystem": "ucum",
            "description": "Exact completed cycle count"
          }
        ]
      }
    ],
    "mappingProfiles": [
