{
  "name": "Equipment commands workshop",
  "tags": [
    {
      "path": "[default]CommandWorkshop/Speed",
      "kind": "memory",
      "dataType": "Double",
      "value": 25,
      "enabled": true
    },
    {
      "path": "[default]CommandWorkshop/Run",
      "kind": "memory",
      "dataType": "Boolean",
      "value": false,
      "enabled": true
    },
    {
      "path": "[default]CommandWorkshop/Note",
      "kind": "memory",
      "dataType": "String",
      "value": "Ready",
      "enabled": true
    },
    {
      "path": "[default]CommandWorkshop/QuickValue",
      "kind": "memory",
      "dataType": "Double",
      "value": 0,
      "enabled": true
    }
  ],
  "commands": [
    {
      "id": "speed",
      "name": "Speed",
      "tagPath": "[default]CommandWorkshop/Speed",
      "dataType": "Double",
      "confirmation": "Change the synthetic speed value?",
      "timeoutMs": 1000,
      "min": 0,
      "max": 100,
      "tolerance": 0
    },
    {
      "id": "run",
      "name": "Run",
      "tagPath": "[default]CommandWorkshop/Run",
      "dataType": "Boolean",
      "confirmation": "Change the synthetic run value?",
      "timeoutMs": 1000
    },
    {
      "id": "note",
      "name": "Note",
      "tagPath": "[default]CommandWorkshop/Note",
      "dataType": "String",
      "confirmation": "Change the synthetic note value?",
      "timeoutMs": 1000,
      "maxLength": 100
    }
  ],
  "screens": [
    {
      "id": "equipment-commands",
      "name": "Equipment commands",
      "width": 1200,
      "height": 740,
      "components": [
        {
          "id": "heading",
          "type": "label",
          "x": 32,
          "y": 24,
          "width": 1100,
          "height": 56,
          "props": {
            "text": "Review \u2192 Confirm \u2192 Readback",
            "fontSize": 30
          }
        },
        {
          "id": "note",
          "type": "label",
          "x": 32,
          "y": 82,
          "width": 1100,
          "height": 56,
          "props": {
            "text": "Synthetic memory tags only. Each command requires explicit Commands permission and a fresh confirmation."
          }
        },
        {
          "id": "cmd-speed",
          "type": "equipmentCommand",
          "x": 32,
          "y": 175,
          "width": 345,
          "height": 275,
          "props": {
            "commandId": "speed",
            "text": "Speed command"
          }
        },
        {
          "id": "actual-speed",
          "type": "value",
          "x": 32,
          "y": 490,
          "width": 345,
          "height": 135,
          "props": {
            "tagPath": "[default]CommandWorkshop/Speed",
            "text": "Live speed"
          }
        },
        {
          "id": "cmd-run",
          "type": "equipmentCommand",
          "x": 407,
          "y": 175,
          "width": 345,
          "height": 275,
          "props": {
            "commandId": "run",
            "text": "Run command"
          }
        },
        {
          "id": "actual-run",
          "type": "value",
          "x": 407,
          "y": 490,
          "width": 345,
          "height": 135,
          "props": {
            "tagPath": "[default]CommandWorkshop/Run",
            "text": "Live run"
          }
        },
        {
          "id": "cmd-note",
          "type": "equipmentCommand",
          "x": 782,
          "y": 175,
          "width": 345,
          "height": 275,
          "props": {
            "commandId": "note",
            "text": "Note command"
          }
        },
        {
          "id": "actual-note",
          "type": "value",
          "x": 782,
          "y": 490,
          "width": 345,
          "height": 135,
          "props": {
            "tagPath": "[default]CommandWorkshop/Note",
            "text": "Live note"
          }
        },
        {
          "id": "open-native", "type": "button", "x": 32, "y": 660, "width": 1095, "height": 48,
          "props": { "text": "Try native Set tag value buttons", "action": "navigate", "targetScreenId": "native-tag-actions" }
        }
      ]
    },
    {
      "id": "native-tag-actions", "name": "Native tag actions", "width": 1200, "height": 780,
      "components": [
        {
          "id": "native-heading", "type": "label", "x": 32, "y": 24, "width": 1130, "height": 48,
          "props": { "text": "Set a tag without a script", "fontSize": 30 }
        },
        {
          "id": "native-help", "type": "label", "x": 32, "y": 82, "width": 1130, "height": 64,
          "props": { "text": "Edit the field, then press its button. Property references read the current field value. Declared command limits and confirmations still apply.", "fontSize": 16 }
        },
        {
          "id": "native-speed", "type": "numberInput", "x": 32, "y": 170, "width": 340, "height": 66,
          "props": { "text": "Requested speed (0–100)", "fieldKey": "nativeSpeed", "defaultValue": 25, "min": 0, "max": 100 }
        },
        {
          "id": "write-speed", "type": "button", "x": 32, "y": 255, "width": 340, "height": 50,
          "props": { "text": "Set speed from input", "action": "setTagValue", "tagWrite": {
            "tagPath": "[default]CommandWorkshop/Speed", "dataType": "Double",
            "valueReference": { "kind": "property", "componentId": "native-speed", "property": "value" }
          } }
        },
        {
          "id": "native-speed-display", "type": "value", "x": 32, "y": 330, "width": 340, "height": 135,
          "props": { "text": "Saved speed", "tagPath": "[default]CommandWorkshop/Speed" }
        },
        {
          "id": "native-run", "type": "checkbox", "x": 420, "y": 170, "width": 340, "height": 66,
          "props": { "text": "Requested run flag", "fieldKey": "nativeRun", "defaultValue": false }
        },
        {
          "id": "write-run", "type": "button", "x": 420, "y": 255, "width": 340, "height": 50,
          "props": { "text": "Set run from checkbox", "action": "setTagValue", "tagWrite": {
            "tagPath": "[default]CommandWorkshop/Run", "dataType": "Boolean",
            "valueReference": { "kind": "property", "componentId": "native-run", "property": "value" }
          } }
        },
        {
          "id": "native-run-display", "type": "value", "x": 420, "y": 330, "width": 340, "height": 135,
          "props": { "text": "Saved run flag", "tagPath": "[default]CommandWorkshop/Run" }
        },
        {
          "id": "native-note", "type": "textInput", "x": 812, "y": 170, "width": 340, "height": 66,
          "props": { "text": "Requested note", "fieldKey": "nativeNote", "defaultValue": "Ready" }
        },
        {
          "id": "write-note", "type": "button", "x": 812, "y": 255, "width": 340, "height": 50,
          "props": { "text": "Set note from input", "action": "setTagValue", "tagWrite": {
            "tagPath": "[default]CommandWorkshop/Note", "dataType": "String",
            "valueReference": { "kind": "property", "componentId": "native-note", "property": "value" }
          } }
        },
        {
          "id": "native-note-display", "type": "value", "x": 812, "y": 330, "width": 340, "height": 135,
          "props": { "text": "Saved note", "tagPath": "[default]CommandWorkshop/Note" }
        },
        {
          "id": "quick-fixed", "type": "button", "x": 32, "y": 480, "width": 340, "height": 50,
          "props": { "text": "Quick write: 25", "action": "setTagValue", "tagWrite": {
            "tagPath": "[default]CommandWorkshop/QuickValue", "dataType": "Double", "value": 25
          } }
        },
        {
          "id": "quick-parent", "type": "button", "x": 32, "y": 555, "width": 340, "height": 50,
          "props": { "text": "Write parent screen height", "action": "setTagValue", "tagWrite": {
            "tagPath": "[default]CommandWorkshop/QuickValue", "dataType": "Double",
            "valueReference": { "kind": "parentProperty", "property": "height" }
          } }
        },
        {
          "id": "quick-display", "type": "value", "x": 420, "y": 480, "width": 340, "height": 135,
          "props": { "text": "Quick value (no confirmation)", "tagPath": "[default]CommandWorkshop/QuickValue" }
        },
        {
          "id": "native-boundary", "type": "label", "x": 812, "y": 480, "width": 340, "height": 125,
          "props": { "text": "These four tags are synthetic memory tags. Designer Preview does not write. Open the published operator application with Commands permission.", "fontSize": 16 }
        },
        {
          "id": "back-commands", "type": "button", "x": 32, "y": 690, "width": 1120, "height": 48,
          "props": { "text": "Back to reviewed equipment controls", "action": "navigate", "targetScreenId": "equipment-commands" }
        }
      ]
    }
  ]
}
