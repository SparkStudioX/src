{
  "name": "Data workshop",
  "connection": {
    "id": "sqlite-data-controls",
    "name": "Data workshop SQLite",
    "type": "sqlite",
    "database": "data-controls.db"
  },
  "queries": [
    {
      "id": "record-choices",
      "name": "Data workshop / Record choices",
      "connectionId": "sqlite-data-controls",
      "kind": "query",
      "sql": "SELECT CAST(id AS TEXT) AS value, machine AS label, quantity FROM production_records ORDER BY id",
      "parameters": []
    },
    {
      "id": "equipment-tree",
      "name": "Data workshop / Equipment hierarchy",
      "connectionId": "sqlite-data-controls",
      "kind": "query",
      "sql": "SELECT 'plant' AS value, 'Plant 1' AS label, NULL AS parent, 0 AS quantity UNION ALL SELECT CAST(id AS TEXT) AS value, machine AS label, 'plant' AS parent, quantity FROM production_records ORDER BY value",
      "parameters": []
    },
    {
      "id": "record-table",
      "name": "Data workshop / Records",
      "connectionId": "sqlite-data-controls",
      "kind": "query",
      "sql": "SELECT id, work_order, machine, quantity, status FROM production_records ORDER BY id",
      "parameters": []
    }
  ],
  "screens": [
    {
      "id": "data-controls",
      "name": "Records and hierarchy",
      "width": 1240,
      "height": 940,
      "components": [
        {
          "id": "heading",
          "type": "label",
          "x": 32,
          "y": 24,
          "width": 1176,
          "height": 50,
          "props": {
            "text": "Choose records. Build workflows.",
            "fontSize": 30
          }
        },
        {
          "id": "intro",
          "type": "label",
          "x": 32,
          "y": 87,
          "width": 1176,
          "height": 44,
          "props": {
            "text": "List and tree selections populate the local form. The table pages the complete loaded result. All records below are synthetic SQLite data.",
            "fontSize": 16
          }
        },
        {
          "id": "record-list",
          "type": "list",
          "x": 32,
          "y": 155,
          "width": 340,
          "height": 275,
          "props": {
            "text": "Production records",
            "fieldKey": "listRecord",
            "defaultValue": "",
            "optionsSource": {
              "queryId": "record-choices",
              "valueColumn": "value",
              "labelColumn": "label"
            },
            "selectionFields": {
              "recordName": "label",
              "quantity": "quantity"
            },
            "events": {
              "commit": {
                "language": "javascript",
                "code": "app.notify('Selected record ' + event.value);"
              }
            }
          }
        },
        {
          "id": "equipment-tree",
          "type": "treeView",
          "x": 400,
          "y": 155,
          "width": 360,
          "height": 275,
          "props": {
            "text": "Equipment hierarchy",
            "fieldKey": "treeRecord",
            "defaultValue": "",
            "optionsSource": {
              "queryId": "equipment-tree",
              "valueColumn": "value",
              "labelColumn": "label",
              "parentColumn": "parent"
            },
            "selectionFields": {
              "recordName": "label",
              "quantity": "quantity"
            },
            "events": {
              "commit": {
                "language": "javascript",
                "code": "app.notify('Selected equipment ' + event.value);"
              }
            }
          }
        },
        {
          "id": "record-name",
          "type": "textInput",
          "x": 796,
          "y": 155,
          "width": 412,
          "height": 80,
          "props": {
            "text": "Record / equipment",
            "fieldKey": "recordName",
            "defaultValue": ""
          }
        },
        {
          "id": "quantity",
          "type": "numberInput",
          "x": 796,
          "y": 250,
          "width": 200,
          "height": 80,
          "props": {
            "text": "Quantity",
            "fieldKey": "quantity",
            "defaultValue": 0,
            "min": 0,
            "max": 1000000
          }
        },
        {
          "id": "inspect",
          "type": "button",
          "x": 796,
          "y": 348,
          "width": 412,
          "height": 58,
          "props": {
            "text": "Preview form values",
            "action": "script",
            "script": "result = {'message': inputs['recordName'] + ' / quantity ' + str(inputs['quantity']) + ' / list ' + inputs['listRecord'] + ' / tree ' + inputs['treeRecord']}"
          }
        },
        {
          "id": "table-note",
          "type": "label",
          "x": 32,
          "y": 465,
          "width": 1176,
          "height": 40,
          "props": {
            "text": "Select a table row to fill the same form. Paging, sorting and filtering preserve your edits.",
            "fontSize": 17
          }
        },
        {
          "id": "records",
          "type": "table",
          "x": 32,
          "y": 522,
          "width": 1176,
          "height": 306,
          "props": {
            "text": "Production records",
            "queryId": "record-table",
            "rowKey": "id",
            "pageSize": 2,
            "selectionFields": {
              "recordName": "machine",
              "quantity": "quantity"
            }
          }
        },
        {
          "id": "footer",
          "type": "label",
          "x": 32,
          "y": 860,
          "width": 1176,
          "height": 45,
          "props": {
            "text": "The preview action validates selections and returns the form values. It does not write to equipment or change the database.",
            "fontSize": 14
          }
        }
      ]
    },
    {
      "id": "reusable-selectors",
      "name": "Independent station forms",
      "width": 1240,
      "height": 700,
      "components": [
        {
          "id": "heading",
          "type": "label",
          "x": 32,
          "y": 20,
          "width": 1176,
          "height": 50,
          "props": {
            "text": "One template, independent selections",
            "fontSize": 30
          }
        },
        {
          "id": "intro",
          "type": "label",
          "x": 32,
          "y": 84,
          "width": 1176,
          "height": 44,
          "props": {
            "text": "Keyboard arrows move focus; Enter or Space selects. In trees, Right expands and Left collapses or moves to a parent.",
            "fontSize": 16
          }
        },
        {
          "id": "station-a",
          "type": "template",
          "x": 32,
          "y": 152,
          "width": 560,
          "height": 510,
          "props": {
            "templateId": "station-selector",
            "parameters": {
              "station": "Station A"
            },
            "borderColor": "#64748b",
            "borderWidth": 1
          }
        },
        {
          "id": "station-b",
          "type": "template",
          "x": 624,
          "y": 152,
          "width": 560,
          "height": 510,
          "props": {
            "templateId": "station-selector",
            "parameters": {
              "station": "Station B"
            },
            "borderColor": "#64748b",
            "borderWidth": 1
          }
        }
      ]
    }
  ],
  "templates": [
    {
      "id": "station-selector",
      "name": "Station selector",
      "width": 560,
      "height": 510,
      "parameters": {
        "station": "Station"
      },
      "components": [
        {
          "id": "heading",
          "type": "label",
          "x": 20,
          "y": 12,
          "width": 520,
          "height": 40,
          "props": {
            "text": "{station}",
            "fontSize": 23
          }
        },
        {
          "id": "status",
          "type": "list",
          "x": 20,
          "y": 64,
          "width": 230,
          "height": 230,
          "props": {
            "text": "Status",
            "fieldKey": "status",
            "defaultValue": "queued",
            "options": [
              {
                "value": "queued",
                "label": "Queued"
              },
              {
                "value": "running",
                "label": "Running"
              },
              {
                "value": "complete",
                "label": "Complete"
              }
            ]
          }
        },
        {
          "id": "asset",
          "type": "treeView",
          "x": 278,
          "y": 64,
          "width": 260,
          "height": 270,
          "props": {
            "text": "Equipment",
            "fieldKey": "asset",
            "defaultValue": "press-1",
            "options": [
              {
                "value": "area-a",
                "label": "Assembly"
              },
              {
                "value": "press-1",
                "label": "Press 1",
                "parentValue": "area-a"
              },
              {
                "value": "press-2",
                "label": "Press 2",
                "parentValue": "area-a"
              },
              {
                "value": "area-b",
                "label": "Packaging"
              },
              {
                "value": "packer",
                "label": "Packer",
                "parentValue": "area-b"
              }
            ]
          }
        },
        {
          "id": "selection",
          "type": "label",
          "x": 20,
          "y": 354,
          "width": 520,
          "height": 42,
          "props": {
            "text": "Selections",
            "fontSize": 16,
            "bindings": {
              "text": {
                "expression": "status + \" / \" + asset",
                "references": {
                  "status": {
                    "kind": "input",
                    "key": "status"
                  },
                  "asset": {
                    "kind": "input",
                    "key": "asset"
                  }
                }
              }
            }
          }
        },
        {
          "id": "inspect",
          "type": "button",
          "x": 20,
          "y": 421,
          "width": 518,
          "height": 58,
          "props": {
            "text": "Inspect this station",
            "action": "script",
            "script": "result = {'message': parameters['station'] + ': ' + inputs['status'] + ' / ' + inputs['asset']}"
          }
        }
      ]
    }
  ],
  "navigation": {
    "startupScreenId": "data-controls",
    "mode": "menu",
    "items": [
      {
        "screenId": "data-controls",
        "label": "Records and hierarchy"
      },
      {
        "screenId": "reusable-selectors",
        "label": "Station forms"
      }
    ]
  }
}
