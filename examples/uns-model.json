    "instances": []
  },
  "upgradeInstances": [
    {
      "path": "[default]Acme/Dallas/Machining/Line1/CNC01",
      "definitionId": "CNC",
      "version": 2,
      "parameters": {
        "Device": "Haas01",
        "IdealCycleSeconds": 42
      },
      "overrides": {}
    }
  ],
  "mqttReferenceRecipe": {
    "format": "sparkstudio.tags",
    "version": 3,
    "tags": [],
    "scanGroups": [],
    "hierarchy": [],
    "udtDefinitions": [
      {
        "id": "TemperatureSensor",
        "version": 1,
        "parameters": [
          {
            "name": "Device",
            "type": "String",
            "required": true
          }
        ],
        "members": [
          {
            "path": "Temperature",
            "kind": "reference",
            "dataType": "Double",
            "target": "[default]Sources/MQTT/{Device}/temperature",
            "unit": "degC",
            "description": "Read-only MQTT temperature mirror"
          }
        ]
      }
    ],
    "instances": [
      {
        "path": "[default]Acme/Dallas/Machining/Line1/Temperature01",
        "definitionId": "TemperatureSensor",
        "version": 1,
        "parameters": {
          "Device": "Haas01"
        },
        "overrides": {}
      },
      {
        "path": "[default]Acme/Dallas/Machining/Line1/Temperature02",
        "definitionId": "TemperatureSensor",
        "version": 1,
        "parameters": {
          "Device": "Haas02"
        },
        "overrides": {}
      }
    ]
  },
  "screens": [
    {
      "id": "uns-model",
      "name": "UNS setup checklist",
      "width": 1100,
      "height": 600,
      "components": [
        {
          "id": "heading",
          "type": "label",
          "x": 24,
          "y": 24,
          "width": 1052,
          "height": 50,
          "props": {
            "text": "UNS model setup · independently authored lab",
            "fontSize": 27
          }
        },
        {
          "id": "steps",
          "type": "label",
          "x": 24,
          "y": 98,
          "width": 1052,
          "height": 300,
          "props": {
            "text": "1. Start tools/run-data-source-simulators.mjs --uns.\n2. Configure MTConnect and create eight raw tags with the exact types and paths in this recipe.\n3. Review Spindle v1, CNC v1 and four hierarchy nodes.\n4. Instantiate two CNCs from CSV; verify 20 tags including the eight raw sources.\n5. Import the separate UNS CNC faceplates project; publish explicitly when ready.\n6. Save Spindle v2 and CNC v2, upgrade only CNC01, then inspect the missing Spindle/Load binding.",
            "fontSize": 20
          }
        },
        {
          "id": "caution",
          "type": "label",
          "x": 24,
          "y": 432,
          "width": 1052,
          "height": 112,
          "props": {
            "text": "This setup recipe is not a .sparkproj or a tag package. Follow docs/architecture/UNS_MODEL_SETUP.md. Import the source-tag recipe through Tags > Import / export, and model recipes through Models > Import / export. No equipment commands, automatic writes, or live gateway data are included.",
            "fontSize": 18
          }
        }
      ]
    }
  ]
}
