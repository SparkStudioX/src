    {
      "id": "messaging-away",
      "name": "Receiver cleanup",
      "width": 1000,
      "height": 420,
      "state": {
        "receipt": {
          "type": "string",
          "value": "No message sent yet."
        }
      },
      "components": [
        {
          "id": "title",
          "type": "label",
          "x": 32,
          "y": 24,
          "width": 936,
          "height": 44,
          "props": {
            "text": "No receivers on this screen",
            "fontSize": 30
          }
        },
        {
          "id": "help",
          "type": "label",
          "x": 32,
          "y": 90,
          "width": 936,
          "height": 74,
          "props": {
            "text": "Close the popup before leaving the stations. Send below: Accepted 0 confirms the old receivers were removed. Returning starts fresh; earlier messages are not replayed.",
            "fontSize": 18
          }
        },
        {
          "id": "send-away",
          "type": "toggle",
          "x": 32,
          "y": 188,
          "width": 450,
          "height": 52,
          "props": {
            "text": "Send session with no receivers",
            "fieldKey": "sendAway",
            "defaultValue": false,
            "events": {
              "change": {
                "language": "javascript",
                "code": "if (event.value) {\n  const receipt = app.sendMessage(\"workshop.note\", { text: \"Sent while away\", from: \"Away\" }, { scope: \"session\" });\n  app.state.set(\"screen\", \"receipt\", \"Accepted \" + receipt.accepted + \" handler(s).\");\n  app.setInput(\"sendAway\", false);\n}"
              }
            }
          }
        },
        {
          "id": "receipt",
          "type": "label",
          "x": 520,
          "y": 188,
          "width": 448,
          "height": 52,
          "props": {
            "text": "No message sent yet.",
            "fontSize": 22,
            "bindings": {
              "text": {
                "expression": "receipt",
                "references": {
                  "receipt": {
                    "kind": "screenState",
                    "key": "receipt"
                  }
                }
              }
            }
          }
        },
        {
          "id": "back",
          "type": "button",
          "x": 32,
