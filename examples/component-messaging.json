{
  "name": "Component messaging workshop",
  "tags": [],
  "templates": [
    {
      "id": "message-card",
      "name": "Message station",
      "width": 544,
      "height": 292,
      "parameters": {
        "station": "A"
      },
      "instanceState": {
        "instanceNote": {
          "type": "string",
          "value": "Instance · waiting"
        },
        "screenNote": {
          "type": "string",
          "value": "Screen · waiting"
        },
        "sessionNote": {
          "type": "string",
          "value": "Session · waiting"
        }
      },
      "components": [
        {
          "id": "title",
          "type": "label",
          "x": 18,
          "y": 10,
          "width": 508,
          "height": 32,
          "props": {
            "text": "Station {station}",
            "fontSize": 24
          }
        },
        {
          "id": "note",
          "type": "textInput",
          "x": 18,
          "y": 47,
          "width": 508,
          "height": 70,
          "props": {
            "text": "Message text — edit and commit for this instance",
            "fieldKey": "note",
            "defaultValue": "Hello",
            "maxLength": 80,
            "events": {
              "commit": {
                "language": "javascript",
                "code": "app.sendMessage(\"workshop.note\", { text: event.value, from: parameters.station }, { scope: \"instance\" });"
              }
            }
          }
        },
        {
          "id": "send-instance",
          "type": "button",
          "x": 18,
          "y": 130,
          "width": 156,
          "height": 38,
          "props": {
            "text": "Send instance",
            "backgroundColor": "#4f63c8",
            "foregroundColor": "#ffffff",
            "action": "message",
            "message": {
              "messageType": "workshop.note",
              "scope": "instance",
              "payload": {
                "text": "Hello from a button",
                "from": "Instance button"
              }
            }
          }
        },
        {
          "id": "send-screen",
          "type": "toggle",
          "x": 184,
          "y": 130,
          "width": 166,
          "height": 38,
          "props": {
            "text": "Send screen",
            "fieldKey": "sendScreen",
            "defaultValue": false,
            "events": {
              "change": {
                "language": "javascript",
                "code": "if (event.value) {\n  app.sendMessage(\"workshop.note\", { text: inputs.note, from: parameters.station }, { scope: \"screen\" });\n  app.setInput(\"sendScreen\", false);\n}"
              }
            }
          }
        },
        {
          "id": "send-session",
          "type": "toggle",
          "x": 360,
          "y": 130,
          "width": 166,
          "height": 38,
          "props": {
            "text": "Send session",
            "fieldKey": "sendSession",
            "defaultValue": false,
            "events": {
              "change": {
                "language": "javascript",
                "code": "if (event.value) {\n  app.sendMessage(\"workshop.note\", { text: inputs.note, from: parameters.station }, { scope: \"session\" });\n  app.setInput(\"sendSession\", false);\n}"
              }
            }
          }
        },
        {
          "id": "instance-receiver",
          "type": "label",
          "x": 18,
          "y": 183,
          "width": 508,
          "height": 28,
          "props": {
            "text": "Instance · waiting",
            "fontSize": 15,
            "bindings": {
              "text": {
                "expression": "note",
                "references": {
                  "note": {
                    "kind": "instanceState",
                    "key": "instanceNote"
                  }
                }
              }
            },
            "messageHandlers": [
              {
                "id": "receive",
                "messageType": "workshop.note",
                "scope": "instance",
                "language": "javascript",
                "code": "app.state.set(\"instance\", \"instanceNote\", \"Instance · \" + String(event.payload.text) + \" · \" + String(event.payload.from));"
              }
            ]
          }
        },
        {
          "id": "screen-receiver",
          "type": "label",
          "x": 18,
          "y": 218,
          "width": 508,
          "height": 28,
          "props": {
            "text": "Screen · waiting",
            "fontSize": 15,
            "bindings": {
              "text": {
                "expression": "note",
                "references": {
                  "note": {
                    "kind": "instanceState",
                    "key": "screenNote"
                  }
                }
              }
            },
            "messageHandlers": [
              {
                "id": "receive",
                "messageType": "workshop.note",
                "scope": "screen",
                "language": "javascript",
                "code": "app.state.set(\"instance\", \"screenNote\", \"Screen · \" + String(event.payload.text) + \" · \" + String(event.payload.from));"
              }
            ]
          }
        },
        {
          "id": "session-receiver",
          "type": "label",
          "x": 18,
          "y": 253,
          "width": 508,
          "height": 28,
          "props": {
            "text": "Session · waiting",
            "fontSize": 15,
            "bindings": {
              "text": {
                "expression": "note",
                "references": {
                  "note": {
                    "kind": "instanceState",
                    "key": "sessionNote"
                  }
                }
              }
            },
            "messageHandlers": [
              {
                "id": "receive",
                "messageType": "workshop.note",
                "scope": "session",
                "language": "javascript",
                "code": "app.state.set(\"instance\", \"sessionNote\", \"Session · \" + String(event.payload.text) + \" · \" + String(event.payload.from));"
              }
            ]
          }
        }
      ]
    }
  ],
