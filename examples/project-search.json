        { "id": "text-match", "type": "button", "x": 574, "y": 550, "width": 442, "height": 54, "props": { "text": "Read-only script example", "action": "script", "script": "# production-summary is mentioned here for search; this script does not execute a query.\nresult = {'message': 'Text matches are not verified references.'}" } },
