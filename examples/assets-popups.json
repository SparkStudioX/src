            "text": "Machine {machine} · local application settings",
            "fontSize": 14
          }
        },
        {
          "id": "target",
          "type": "numberInput",
          "x": 20,
          "y": 123,
          "width": 220,
          "height": 76,
          "props": {
            "text": "Target rate",
            "fieldKey": "target",
            "tagPath": "[default]Workcenters/{machine}/Target",
            "min": 0,
            "max": 200,
            "defaultValue": 90
          }
        },
        {
          "id": "mode",
          "type": "select",
          "x": 260,
          "y": 123,
          "width": 220,
          "height": 76,
          "props": {
            "text": "Operating mode",
            "fieldKey": "mode",
            "tagPath": "[default]Workcenters/{machine}/Mode",
            "defaultValue": "automatic",
            "options": [
              {
                "label": "Automatic",
                "value": "automatic"
              },
              {
                "label": "Manual",
                "value": "manual"
              }
            ]
          }
        },
        {
          "id": "apply",
          "type": "button",
          "x": 20,
          "y": 226,
          "width": 220,
          "height": 48,
          "props": {
            "text": "Save {machine} settings",
            "action": "script",
            "script": "machine = parameters['machine']\npaths = ['[default]Workcenters/' + machine + '/Target', '[default]Workcenters/' + machine + '/Mode']\nqualities = system.tag.writeBlocking(paths, [inputs['target'], inputs['mode']])\nif not all(quality.isGood() for quality in qualities):\n    raise RuntimeError('Settings were not fully saved. Check the configured memory tags.')\nresult = {'message': machine + ' settings saved.'}"
          }
        },
        {
          "id": "saved-target",
          "type": "value",
          "x": 20,
          "y": 314,
          "width": 220,
          "height": 155,
          "props": {
