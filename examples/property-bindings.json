{
  "name": "Property binding workshop",
  "tags": [
    {
      "path": "[default]BindingWorkshop/Permit",
      "kind": "memory",
      "dataType": "Boolean",
      "value": true,
      "enabled": true
    }
  ],
  "screens": [
    {
      "id": "property-binding-workshop",
      "name": "Binding workshop",
      "width": 960,
      "height": 650,
      "components": [
        {
          "id": "binding-heading",
          "type": "label",
          "x": 32,
          "y": 24,
          "width": 800,
          "height": 42,
          "props": {
            "text": "Application logic workshop",
            "fontSize": 28
          }
        },
        {
          "id": "binding-help",
          "type": "label",
          "x": 32,
          "y": 76,
          "width": 820,
          "height": 46,
          "props": {
            "text": "Change quantity and Show details. Bindings update immediately; Apply runs Python.",
            "fontSize": 14
          }
        },
        {
          "id": "quantity",
          "type": "spinner",
          "x": 32,
          "y": 150,
          "width": 260,
          "height": 90,
          "props": {
            "text": "Quantity",
            "fieldKey": "quantity",
            "defaultValue": 0,
            "min": 0,
            "max": 100,
            "step": 1
          }
        },
        {
          "id": "show-details",
          "type": "checkbox",
          "x": 330,
          "y": 150,
          "width": 250,
          "height": 90,
          "props": {
            "text": "Show details",
            "fieldKey": "showDetails",
            "defaultValue": true
          }
        },
        {
          "id": "binding-status",
          "type": "label",
          "x": 32,
          "y": 275,
          "width": 550,
          "height": 55,
          "props": {
            "text": "Waiting for quantity",
            "fontSize": 23,
            "customProperties": {
              "minimum": {
                "type": "number",
                "value": 0
              }
            },
            "bindings": {
              "text": {
                "expression": "quantity > minimum ? \"Ready to apply\" : \"Enter a quantity above zero\"",
                "references": {
                  "quantity": {
                    "kind": "input",
                    "key": "quantity"
                  },
                  "minimum": {
                    "kind": "custom",
                    "key": "minimum"
                  }
                }
              },
              "color": {
                "expression": "quantity > minimum ? \"#23866b\" : \"#ac5e19\"",
                "references": {
                  "quantity": {
                    "kind": "input",
                    "key": "quantity"
                  },
                  "minimum": {
                    "kind": "custom",
                    "key": "minimum"
                  }
                }
              }
            }
          }
        },
        {
          "id": "binding-details",
          "type": "label",
          "x": 32,
          "y": 350,
          "width": 680,
          "height": 80,
          "props": {
            "text": "This section follows Show details. Hidden controls remain selectable in Design mode.",
            "fontSize": 18,
            "bindings": {
              "visible": {
                "expression": "show",
                "references": {
                  "show": {
                    "kind": "input",
                    "key": "showDetails"
                  }
                }
              }
            }
          }
        },
        {
          "id": "binding-apply",
          "type": "button",
          "x": 32,
          "y": 470,
          "width": 260,
          "height": 60,
          "props": {
            "text": "Apply quantity",
            "action": "script",
            "script": "print(\"Applied quantity:\", inputs[\"quantity\"])\nresult = {\"quantity\": inputs[\"quantity\"], \"showDetails\": inputs[\"showDetails\"]}",
            "customProperties": {
              "minimum": {
                "type": "number",
                "value": 0
              }
            },
            "bindings": {
              "enabled": {
                "expression": "quantity > minimum && permit",
                "references": {
                  "quantity": {
                    "kind": "input",
                    "key": "quantity"
                  },
                  "minimum": {
                    "kind": "custom",
                    "key": "minimum"
                  },
                  "permit": {
                    "kind": "tag",
                    "path": "[default]BindingWorkshop/Permit"
                  }
                }
              },
              "text": {
                "expression": "quantity > minimum ? \"Apply quantity\" : \"Enter quantity first\"",
                "references": {
                  "quantity": {
                    "kind": "input",
                    "key": "quantity"
                  },
                  "minimum": {
                    "kind": "custom",
                    "key": "minimum"
                  }
                }
              }
            }
          }
        },
        {
          "id": "binding-scope-help",
          "type": "label",
          "x": 330,
          "y": 470,
          "width": 530,
          "height": 90,
          "props": {
            "text": "Apply also requires the local Permit memory tag. Its Python event only returns the form values.",
            "fontSize": 15
          }
        }
      ]
    }
  ]
}
