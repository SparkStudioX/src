{
  "name": "Template property workshop",
  "tags": [],
  "templates": [
    {
      "id": "station-form",
      "name": "Station form",
      "width": 360,
      "height": 320,
      "parameters": {
        "station": "Station",
        "limit": "40",
        "permit": "true"
      },
      "components": [
        {
          "id": "heading",
          "type": "label",
          "x": 20,
          "y": 18,
          "width": 320,
          "height": 40,
          "props": {
            "text": "{station}",
            "fontSize": 24
          }
        },
        {
          "id": "note",
          "type": "label",
          "x": 20,
          "y": 64,
          "width": 320,
          "height": 42,
          "props": {
            "text": "Limit: {limit} units · Permission: {permit}",
            "fontSize": 14
          }
        },
        {
          "id": "quantity",
          "type": "spinner",
          "x": 20,
          "y": 116,
          "width": 320,
          "height": 84,
          "props": {
            "text": "Quantity for {station}",
            "fieldKey": "quantity",
            "defaultValue": 12,
            "min": 1,
            "max": 100,
            "step": 1,
            "bindings": {
              "enabled": {
                "expression": "permit",
                "references": {
                  "permit": {
                    "kind": "parameter",
                    "key": "permit"
                  }
                }
              }
            }
          }
        },
        {
          "id": "preview",
          "type": "button",
          "x": 20,
          "y": 224,
          "width": 320,
          "height": 48,
          "props": {
            "text": "Preview {station}",
            "action": "script",
            "script": "assert isinstance(parameters['limit'], (int, float)) and not isinstance(parameters['limit'], bool)\nassert isinstance(parameters['permit'], bool)\nassert parameters['permit'] and inputs['quantity'] <= parameters['limit']\nresult = {'message': parameters['station'] + ': ' + str(inputs['quantity']) + ' units previewed. Typed limit=' + str(parameters['limit']) + ', permit=' + str(parameters['permit']) + '. Nothing was written.'}",
            "bindings": {
              "enabled": {
                "expression": "permit && quantity <= limit",
                "references": {
                  "permit": {
                    "kind": "parameter",
                    "key": "permit"
                  },
                  "limit": {
                    "kind": "parameter",
                    "key": "limit"
                  },
                  "quantity": {
                    "kind": "input",
                    "key": "quantity"
                  }
                }
              }
            }
          }
        }
      ],
      "parameterTypes": {
        "limit": "number",
        "permit": "boolean"
      }
    }
  ],
  "screens": [
    {
      "id": "template-property-workshop",
