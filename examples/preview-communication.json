      { "id": "echo", "type": "button", "x": 18, "y": 160, "width": 434, "height": 48, "props": { "text": "Run nested Python message", "action": "script", "script": "result = {'message': 'Nested Python ran for ' + parameters['station'] + '. No gateway data was changed.'}" } }
    ]
  }],
  "screens": [{
