      { "id": "note-caption", "type": "label", "x": 540, "y": 180, "width": 496, "height": 80, "props": { "text": "Local note", "fontSize": 21, "bindings": { "text": { "expression": "'Local note: ' + note", "references": { "note": { "kind": "input", "key": "note" } } } } } },
      { "id": "summary", "type": "table", "x": 24, "y": 284, "width": 1012, "height": 190, "props": { "text": "Built-in sample query remains readable", "queryId": "production-summary", "parameters": { "line": "Line1" } } },
      { "id": "panel", "type": "template", "x": 24, "y": 500, "width": 470, "height": 230, "props": { "templateId": "preview-panel", "parameters": { "station": "Assembly" }, "borderColor": "#697aac", "borderWidth": 1 } },
      { "id": "script", "type": "button", "x": 540, "y": 514, "width": 496, "height": 48, "props": { "text": "Run screen Python message", "action": "script", "script": "result = {'message': 'Screen Python ran. Note: ' + inputs['note'] + '. No gateway data was changed.'}" } },
      { "id": "popup", "type": "button", "x": 540, "y": 588, "width": 496, "height": 48, "props": { "text": "Open local popup", "action": "openPopup", "targetScreenId": "preview-popup" } },
      { "id": "mode-help", "type": "label", "x": 540, "y": 662, "width": 496, "height": 82, "props": { "text": "Changing communication mode resets the preview form and popup. Leaving Preview and returning always starts read-only.", "fontSize": 17 } },
      { "id": "footer", "type": "label", "x": 24, "y": 786, "width": 1012, "height": 74, "props": { "text": "Original synthetic workshop · Built-in sample data · No tag or database writes · Bundled Python is needed only for the optional live-action message checks", "fontSize": 16 } }
    ]
  }, {
