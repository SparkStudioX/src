      { "id": "script", "type": "button", "x": 24, "y": 200, "width": 592, "height": 48, "props": { "text": "Run popup Python message", "action": "script", "script": "result = {'message': 'Popup Python ran. No gateway data was changed.'}" } },
      { "id": "close", "type": "button", "x": 24, "y": 274, "width": 592, "height": 48, "props": { "text": "Close popup", "action": "closePopup" } }
