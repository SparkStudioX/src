          "props": {
            "value": 42.5,
            "min": 0,
            "max": 100,
            "decimals": 1,
            "unit": "L",
            "showValue": true,
            "showPercent": true,
            "borderWidth": 1,
            "borderColor": "#64748b",
            "text": "Storage tank",
            "color": "#3b82f6",
            "bindings": {
              "value": {
                "expression": "available ? reading : missing",
                "references": {
                  "available": {
                    "kind": "input",
                    "key": "available"
                  },
                  "reading": {
                    "kind": "input",
                    "key": "reading"
                  },
                  "missing": {
                    "kind": "tag",
                    "path": "[default]ProcessWorkshop/Unavailable"
                  }
                }
              }
            }
          }
        },
        {
          "id": "level",
          "type": "levelIndicator",
          "x": 408,
          "y": 474,
          "width": 344,
          "height": 284,
          "props": {
            "value": 42.5,
            "min": 0,
            "max": 100,
            "decimals": 1,
            "unit": "mm",
            "showValue": true,
            "showPercent": true,
            "borderWidth": 1,
            "borderColor": "#64748b",
            "text": "Process level",
            "orientation": "vertical",
            "color": "#0891b2",
            "bindings": {
              "value": {
                "expression": "available ? reading : missing",
                "references": {
                  "available": {
                    "kind": "input",
                    "key": "available"
                  },
                  "reading": {
                    "kind": "input",
                    "key": "reading"
                  },
                  "missing": {
                    "kind": "tag",
                    "path": "[default]ProcessWorkshop/Unavailable"
                  }
                }
              }
            }
          }
        },
        {
          "id": "temperature",
          "type": "thermometer",
          "x": 784,
          "y": 474,
          "width": 364,
          "height": 284,
          "props": {
            "value": 42.5,
            "min": -20,
            "max": 100,
            "decimals": 1,
            "unit": "°C",
            "showValue": true,
            "showPercent": false,
            "borderWidth": 1,
            "borderColor": "#64748b",
            "text": "Temperature",
            "color": "#d97706",
            "bindings": {
              "value": {
                "expression": "available ? reading * 1.2 - 20 : missing",
                "references": {
                  "available": {
                    "kind": "input",
                    "key": "available"
                  },
                  "reading": {
                    "kind": "input",
                    "key": "reading"
                  },
                  "missing": {
                    "kind": "tag",
                    "path": "[default]ProcessWorkshop/Unavailable"
                  }
                }
              },
              "color": {
                "expression": "reading > 80 ? \"#dc2626\" : \"#d97706\"",
                "references": {
                  "reading": {
                    "kind": "input",
                    "key": "reading"
                  }
                }
              }
            }
          }
        },
        {
          "id": "hint",
          "type": "label",
          "x": 32,
          "y": 782,
          "width": 1116,
          "height": 36,
          "props": {
            "text": "Use the property sheet to bind Value, range, units, precision and presentation. Off-scale values retain their actual number; unavailable sources never become zero.",
