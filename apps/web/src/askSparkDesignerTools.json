  {
    "name": "spark_designer_create_components",
    "description": "Add components in supplied Z order (later is above earlier). For large layouts, generate at most 10 components per call and continue with the returned snapshotToken; the API supports up to 200 simple components but large generated calls can be truncated or malformed. Existing components remain. Read component_schema for the chosen types and dependencies first. For clickable buttons, use a supported string props.action with its companion fields; props.script is Python.",
    "parameters": {
      "type": "object",
      "properties": {
        "snapshotToken": {
          "type": "string",
          "description": "Exact token from inspect_context or the preceding successful draft edit."
        },
        "documentId": {
          "type": "string"
        },
        "documentKind": {
          "type": "string",
          "enum": [
            "screen",
            "template"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "type": {
                "type": "string",
                "enum": [
                  "alarmStatusTable",
                  "alarmJournalTable",
                  "historicalTrend",
                  "chart",
                  "sparkline",
                  "equipmentCommand",
                  "label",
                  "value",
                  "gauge",
                  "button",
                  "table",
                  "list",
                  "treeView",
                  "textInput",
                  "formattedInput",
                  "barcodeInput",
                  "viewContainer",
                  "passwordInput",
                  "multiStateButton",
                  "multiStateIndicator",
                  "ledDisplay",
                  "progressBar",
                  "cylindricalTank",
                  "levelIndicator",
                  "thermometer",
                  "textArea",
                  "numberInput",
                  "spinner",
                  "slider",
                  "checkbox",
                  "toggle",
                  "select",
                  "radioGroup",
                  "dateTimeInput",
                  "template",
                  "repeater",
                  "image",
                  "computerCamera",
                  "icon",
                  "line",
                  "rectangle",
                  "ellipse",
                  "polyline",
                  "pipe",
                  "equipmentSymbol"
                ]
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 8192
              },
              "width": {
                "type": "number",
                "minimum": 1,
                "maximum": 8192
              },
              "height": {
                "type": "number",
                "minimum": 1,
                "maximum": 8192
              },
              "groupId": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
              },
              "props": {
                "type": "object",
                "additionalProperties": true,
                "description": "Use component_schema(type) for properties and basic actions; request include for advanced action/event/binding formats. action is a string; script is Python source. Colors are hex, including #00000000 for transparency.",
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "navigate",
                      "script",
                      "openPopup",
                      "closePopup",
                      "message",
                      "setTagValue"
                    ]
                  },
                  "script": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 65536
                  },
                  "targetScreenId": {
                    "type": "string"
                  },
                  "message": {
                    "type": "object",
                    "properties": {
                      "messageType": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "instance",
                          "screen",
                          "session"
                        ]
                      },
                      "payload": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    },
                    "required": [
                      "messageType",
                      "scope",
                      "payload"
                    ],
                    "additionalProperties": false
                  },
                  "backgroundColor": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "foregroundColor": {
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                  },
                  "events": {
                    "type": "object",
                    "description": "Input components only: change/commit => {language:\"javascript\"|\"python\",code:string}. Password change/commit supports JavaScript only. Never use for button clicks.",
                    "additionalProperties": true
                  },
                  "componentEvents": {
                    "type": "object",
                    "description": "mount/unmount/propertyChange/focus/blur/keyDown/keyUp/doubleClick/pointerDown/pointerUp => {language,code}; propertyChange also requires properties:string[]. No click/onClick event.",
                    "additionalProperties": true
                  }
                }
              }
            },
            "required": [
              "id",
              "type",
              "x",
              "y",
              "width",
              "height",
              "props"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "snapshotToken",
        "documentId",
        "documentKind",
        "components"
      ],
      "additionalProperties": false
    },
    "category": "designer",
    "kind": "draft",
    "target": "designer",
    "permission": "design",
    "confirmation": false,
    "parallelSafe": false
  },
  {
    "name": "spark_designer_update_components",
    "description": "Apply the same layout/property patch to all explicit componentIds in one call. Prefer this to many apply_edits operations for a shared appearance change. Send only changed props; do not repeat unchanged scripts or geometry. Props shallow-merge, so include every sibling of a nested object being replaced. Read component_schema(type,include:[sectionName]) for advanced actions/events. Use set_binding for individual bindings.",
    "parameters": {
      "type": "object",
      "properties": {
        "snapshotToken": {
          "type": "string",
          "description": "Exact token from inspect_context or the preceding successful draft edit."
        },
        "documentId": {
          "type": "string"
        },
        "documentKind": {
          "type": "string",
          "enum": [
            "screen",
            "template"
          ]
        },
        "componentIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patch": {
          "type": "object",
          "additionalProperties": true,
          "description": "Allowed: x,y,width,height,groupId,props. Use props for actions, scripting, tagPath, templates, tables, chart/history/alarms, assetId, drawings and other authored settings.",
          "properties": {
            "props": {
              "type": "object",
              "additionalProperties": true,
              "description": "Use component_schema(type) for properties and basic actions; request include for advanced action/event/binding formats. action is a string; script is Python source. Colors are hex, including #00000000 for transparency.",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "navigate",
                    "script",
                    "openPopup",
                    "closePopup",
                    "message",
                    "setTagValue"
                  ]
                },
                "script": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                },
                "targetScreenId": {
                  "type": "string"
                },
                "message": {
                  "type": "object",
                  "properties": {
                    "messageType": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "scope": {
                      "type": "string",
                      "enum": [
                        "instance",
                        "screen",
                        "session"
                      ]
                    },
                    "payload": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "messageType",
                    "scope",
                    "payload"
                  ],
                  "additionalProperties": false
                },
                "backgroundColor": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "foregroundColor": {
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
                },
                "events": {
                  "type": "object",
                  "description": "Input components only: change/commit => {language:\"javascript\"|\"python\",code:string}. Password change/commit supports JavaScript only. Never use for button clicks.",
                  "additionalProperties": true
                },
                "componentEvents": {
                  "type": "object",
                  "description": "mount/unmount/propertyChange/focus/blur/keyDown/keyUp/doubleClick/pointerDown/pointerUp => {language,code}; propertyChange also requires properties:string[]. No click/onClick event.",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "required": [
        "snapshotToken",
        "documentId",
        "documentKind",
        "componentIds",
        "patch"
      ],
      "additionalProperties": false
    },
    "category": "designer",
    "kind": "draft",
    "target": "designer",
    "permission": "design",
    "confirmation": false,
    "parallelSafe": false
  },
