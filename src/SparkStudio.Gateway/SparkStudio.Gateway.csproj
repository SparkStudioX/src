<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.2.0-preview.10</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.10</FileVersion>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../apps/web/src/runtimeProperties.json" LogicalName="SparkStudio.RuntimeProperties.json" />
    <ProjectReference Include="../SparkStudio.Connectors/SparkStudio.Connectors.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104" />
    <Content Include="../../runtimes/python/worker.py" Link="python/worker.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
