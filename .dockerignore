# Default-deny context: release builds need authored application files only.
**
!Dockerfile
!LICENSE
!global.json
!Directory.Build.props
!NuGet.Config
!apps/
!apps/web/
!apps/web/package.json
!apps/web/package-lock.json
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!apps/web/index.html
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!src/
!src/SparkStudio.Gateway/
!src/SparkStudio.Gateway/*.cs
!src/SparkStudio.Gateway/*.csproj
!src/SparkStudio.Gateway/appsettings.json
!src/SparkStudio.Gateway/packages.linux-x64.lock.json
!src/SparkStudio.Gateway/packages.linux-arm64.lock.json
!src/SparkStudio.Connectors/
!src/SparkStudio.Connectors/*.cs
!src/SparkStudio.Connectors/*.csproj
!src/SparkStudio.Connectors/NuGet.Config
!src/SparkStudio.Connectors/packages.linux-x64.lock.json
!src/SparkStudio.Connectors/packages.linux-arm64.lock.json
!runtimes/
!runtimes/python/
!runtimes/python/worker.py
!tools/
!tools/docker-entrypoint.py
!tools/container-admin.py
!tools/collect-docker-runtime.py
!tools/write-docker-notices.mjs
!tools/package-notice-supplements.mjs
# Even inside allowed source trees, never transfer local artifacts or secrets.
**/node_modules
**/bin
**/obj
**/dist
**/wwwroot
**/.env*
**/*.pem
**/*.key
**/*.crt
**/*.pfx
**/*.db
**/*.sqlite*
**/*.log
