<Project>
  <!-- Builds the AnyLog plugin with the gateway and copies only its assembly into output/plugins.
       The gateway project references this file when it exists, so a SparkStudio tree without the plugin still builds. -->
  <Target Name="BuildAnyLogQueryConnector" AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'SparkStudio.Gateway' and Exists('$(MSBuildThisFileDirectory)SparkStudio.Connectors.AnyLog/SparkStudio.Connectors.AnyLog.csproj')">
    <!-- The plugin is not a gateway ProjectReference. Build it here, including Restore, so an artifacts-path lint build has project.assets.json. GetTargetPath only names the DLL and does not compile it. -->
    <MSBuild Projects="$(MSBuildThisFileDirectory)SparkStudio.Connectors.AnyLog/SparkStudio.Connectors.AnyLog.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration);_QualityContextPath=$(_QualityContextPath);_QualityContextToken=$(_QualityContextToken)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)SparkStudio.Connectors.AnyLog/SparkStudio.Connectors.AnyLog.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);_QualityContextPath=$(_QualityContextPath);_QualityContextToken=$(_QualityContextToken)">
      <Output TaskParameter="TargetOutputs" ItemName="_AnyLogConnectorAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(_AnyLogConnectorAssembly)" DestinationFolder="$(TargetDir)plugins" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishAnyLogQueryConnector" AfterTargets="Publish"
          Condition="'$(MSBuildProjectName)' == 'SparkStudio.Gateway' and Exists('$(MSBuildThisFileDirectory)SparkStudio.Connectors.AnyLog/SparkStudio.Connectors.AnyLog.csproj')">
    <MSBuild Projects="$(MSBuildThisFileDirectory)SparkStudio.Connectors.AnyLog/SparkStudio.Connectors.AnyLog.csproj" Targets="Restore"
             Properties="Configuration=$(Configuration);_QualityContextPath=$(_QualityContextPath);_QualityContextToken=$(_QualityContextToken)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)SparkStudio.Connectors.AnyLog/SparkStudio.Connectors.AnyLog.csproj" Targets="Build"
             Properties="Configuration=$(Configuration);_QualityContextPath=$(_QualityContextPath);_QualityContextToken=$(_QualityContextToken)">
      <Output TaskParameter="TargetOutputs" ItemName="_AnyLogConnectorPublishAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(_AnyLogConnectorPublishAssembly)" DestinationFolder="$(PublishDir)plugins" SkipUnchangedFiles="true" />
  </Target>
</Project>
